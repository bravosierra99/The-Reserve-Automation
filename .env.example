# Reserve Automation Environment Variables
# Copy this file to .env and fill in your values
# Generate WEB_SECRET_KEY with: openssl rand -hex 32

# =============================================================================
# REQUIRED
# =============================================================================

# Web application secret key (REQUIRED)
WEB_SECRET_KEY=

# Obsidian vault host path (REQUIRED for Docker)
# WSL example: /mnt/d/Users/yourname/Documents/the-reserve
# Proxmox example: /mnt/storage/vaults/the-reserve
VAULT_HOST_PATH=

# =============================================================================
# LM STUDIO CONNECTION
# =============================================================================

# Local development (non-Docker)
RESERVE_LM_STUDIO_URL=http://localhost:1234/v1

# Docker: LM Studio host - use your Windows host's actual IP
# This works from both Docker Desktop AND Proxmox
# Find your IP with: ipconfig (Windows) or hostname -I (Linux)
LM_STUDIO_HOST=192.168.86.2
LM_STUDIO_PORT=1234

# Alternative for Docker Desktop only:
# LM_STUDIO_HOST=host.docker.internal

# LM Studio API key — required when LM Studio's API-key auth is enabled.
# Generate one in LM Studio → Developer → API Keys.
# LM_STUDIO_API_KEY=sk-lm-...

# =============================================================================
# PORT CONFIGURATION
# =============================================================================

WEB_PORT=8000
OBSIDIAN_PORT=8080

# =============================================================================
# OPTIONAL API KEYS
# =============================================================================

# Anthropic API key for cloud LLM (optional)
# ANTHROPIC_API_KEY=sk-ant-...

# LLMWhisperer API key for PDF extraction (optional)
# LLMWHISPERER_API_KEY=...

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# =============================================================================

# Vault path for local (non-Docker) development
RESERVE_VAULT_PATH=/mnt/d/Users/yourname/Documents/the-reserve/Cellar

# =============================================================================
# CLOUDFLARE SERVICE TOKEN (for scripts accessing prod API)
# =============================================================================
# From Cloudflare Zero Trust > Access > Service Auth > Service Tokens
# CF_ACCESS_CLIENT_ID: the service token Client ID (ends in .access)
#   - used by populate-ingredients script to authenticate with CF Access
#   - also passed into the container so auth.yaml can grant it admin role
# CF_ACCESS_CLIENT_SECRET: the service token secret (only needed by the script, not the container)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
