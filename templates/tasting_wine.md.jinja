{# CLAUDE_REQ: This template MUST match the-reserve/Cellar/9_Templates/Tasting Note AWS.md - always compare before modifying #}
{# CLAUDE_REQ: fileClass must be "Wine Tasting" (matches DataviewJS queries in bottle templates) #}
{# CLAUDE_REQ: Date, TasterName, and LinkedBottle must be quoted strings #}
{# CLAUDE_REQ: All score fields (Appearance, Aroma, Taste, Aftertaste, Overall, AWS Score, 100pt Scale) are required #}
---
fileClass: Wine Tasting
Date: "{{ tasting_date }}"
TasterName: "{{ taster_name }}"
Appearance: {{ wine_appearance }}
Aroma: {{ wine_aroma }}
Taste: {{ wine_taste }}
Aftertaste: {{ wine_aftertaste }}
Overall: {{ wine_overall }}
AWS Score: {{ aws_score }}
100pt Scale: {{ scale_100pt }}
LinkedBottle: "[[{{ bottle_name }}]]"
---

