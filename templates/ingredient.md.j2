### Ancestors

{% raw %}
```dataviewjs
const parent = dv.current().Parent;
if (!parent) {
    dv.paragraph("Root ingredient.");
} else {
    const parts = [];
    let current = parent;
    while (current) {
        const page = dv.pages('"2_Ingredients"')
            .where(p => p.fileClass === "Ingredient" && p.IngredientName === current)
            .first();
        if (page) {
            parts.unshift(page.file.link);
            current = page.Parent;
        } else {
            parts.unshift(current);
            break;
        }
    }
    dv.paragraph("Path: " + parts.join(" > "));
}
```
