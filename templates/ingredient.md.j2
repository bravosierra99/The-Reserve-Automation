### Children

{% raw %}
```dataviewjs
const currentName = dv.current().IngredientName;
const ingredients = dv.pages('"2_Ingredients"')
    .where(p => p.fileClass === "Ingredient" && p.Parent === currentName);

if (ingredients.length === 0) {
    dv.paragraph("No child ingredients.");
} else {
    dv.table(
        ["Name", "Cost"],
        ingredients.map(p => [
            p.file.link,
            p.Cost ? "$" + p.Cost : ""
        ])
    );
}
```
