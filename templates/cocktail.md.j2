### Tasting Notes

{% raw %}
```dataviewjs
const cocktailName = dv.current().file.name;
const tastings = dv.pages('"3_Cocktails/' + cocktailName + '"')
    .where(p => p.fileClass === "Cocktail Tasting")
    .sort(p => p.Date, 'desc');

if (tastings.length === 0) {
    dv.paragraph("No tastings recorded yet.");
} else {
    const avgScore = tastings.map(t => t.Score || 0).reduce((a, b) => a + b, 0) / tastings.length;
    dv.paragraph(`**Average Score:** ${avgScore.toFixed(1)}/10 (${tastings.length} tastings)`);

    dv.table(
        ["Tasting", "Date", "Taster", "Score", "Bartender"],
        tastings.map(p => [
            p.file.link,
            p.Date,
            p.TasterName,
            p.Score,
            p.Bartender || ""
        ])
    );
}
```
