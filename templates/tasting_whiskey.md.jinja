{# CLAUDE_REQ: fileClass must be "Tasting" (matches DataviewJS queries in bottle templates) #}
{# CLAUDE_REQ: Date, TasterName, and LinkedBottle must be quoted strings #}
{# CLAUDE_REQ: DaysFromCrack and FillLevel should ALWAYS be included (even if 0) - don't use conditional #}
---
fileClass: Tasting
Date: "{{ tasting_date }}"
TasterName: "{{ taster_name }}"
DaysFromCrack: {{ days_from_crack if days_from_crack is not none else 0 }}
FillLevel: {{ fill_level if fill_level is not none else 100 }}
Nose: {{ whiskey_nose }}
Palate: {{ whiskey_palate }}
Finish: {{ whiskey_finish }}
Overall: {{ whiskey_overall }}
TotalScore: {{ total_score }}
LinkedBottle: "[[{{ bottle_name }}]]"
